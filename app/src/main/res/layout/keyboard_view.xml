<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#171725"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Ready"
            android:textColor="#EDEDF7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="MOONSHINE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#171725"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:background="#A29BFE"/>

        <Button
            android:id="@+id/btnKeyboardGear"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="⚙"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34344A"
            android:contentDescription="Settings"/>

        <Button
            android:id="@+id/btnCloseKeyboard"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="×"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34344A"
            android:contentDescription="Switch keyboard"/>
    </LinearLayout>

    <!-- Configuration -->
    <TextView
        android:id="@+id/tvLabels"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:textColor="#AAA9C9"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Main microphone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnMicCircle"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#00B894"
            android:src="@drawable/ic_mic"
            android:contentDescription="Start or stop voice recording"/>
    </LinearLayout>

    <!-- Keyboard controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBackspace"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="⌫"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_keyboard_key"
            android:contentDescription="Backspace"/>

        <Button
            android:id="@+id/btnSpace"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:text="SPACE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_keyboard_key"
            android:contentDescription="Space"/>

        <Button
            android:id="@+id/btnEnter"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="↵"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_keyboard_key"
            android:contentDescription="Enter"/>
    </LinearLayout>

    <!-- Outstanding transcript -->
    <LinearLayout
        android:id="@+id/rowOutstanding"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnTypeOutstanding"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Type pending transcript"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5C7CFA"/>

        <Button
            android:id="@+id/btnDiscardOutstanding"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="×"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555566"/>
    </LinearLayout>

    <!-- Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/progressTranscribe"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"/>

        <TextView
            android:id="@+id/tvProgressPct"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0%"
            android:textColor="#A29BFE"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Processing -->
    <LinearLayout
        android:id="@+id/rowProcessing"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSkipOne"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="Skip"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E17055"/>

        <Button
            android:id="@+id/btnStopAll"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Stop All"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D63031"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvQueueBadge"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center"
        android:textColor="#AAA9C9"
        android:textSize="10sp"/>

</LinearLayout>
